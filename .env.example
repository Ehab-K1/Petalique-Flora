# ─── Petalique Flora — environment ───────────────────────────────────────────
# Copy to `.env.local` and fill in to activate live services.
# The site runs fully in "demo mode" with all of these blank — every flow works,
# checkout simulates an order, and form submissions are logged server-side.

# Stripe — enables real card checkout. Get keys at https://dashboard.stripe.com
# When STRIPE_SECRET_KEY is set, /checkout creates a real Stripe Checkout Session.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL — used for Stripe redirect URLs and canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Concierge / inquiry routing (optional) — where inquiry + lead emails are sent.
# Wire to Resend / Postmark / SendGrid in app/api/inquiry/route.ts.
INQUIRY_NOTIFY_EMAIL=
RESEND_API_KEY=

# Same-day delivery cutoff (24h local time, America/Toronto). Default 13:00 (1pm).
NEXT_PUBLIC_SAMEDAY_CUTOFF_HOUR=13
